# $1 is 0 on removal, 1 on upgrade.
if [ "$1" -eq 0 ]; then
	@GPUSHIFT_HELPER_PATH@ reset || echo "gpushift: could not undo the GPU mode changes; see @CMAKE_INSTALL_FULL_DOCDIR@/RECOVERY.md" >&2
	if [ -x /usr/bin/systemctl ]; then
		systemctl disable gpushift-boot-check.service >/dev/null 2>&1 || :
	fi
fi
